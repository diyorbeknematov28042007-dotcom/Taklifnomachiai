<svg width="1200" height="630" viewBox="0 0 1200 630" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#8B5CF6"/>
      <stop offset="55%" style="stop-color:#a855f7"/>
      <stop offset="100%" style="stop-color:#EC4899"/>
    </linearGradient>
    <linearGradient id="env" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ffffff"/>
      <stop offset="100%" style="stop-color:#f3e8ff"/>
    </linearGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="20" flood-color="#000" flood-opacity="0.18"/>
    </filter>
  </defs>

  <!-- Fon -->
  <rect width="1200" height="630" fill="url(#bg)"/>

  <!-- Dekorativ doiralar -->
  <circle cx="1050" cy="120" r="180" fill="#ffffff" opacity="0.07"/>
  <circle cx="150" cy="520" r="140" fill="#ffffff" opacity="0.06"/>

  <!-- Konvert ikonka (chap) -->
  <g transform="translate(140, 195)" filter="url(#shadow)">
    <rect x="0" y="30" width="240" height="160" rx="14" fill="url(#env)"/>
    <path d="M0 44 L120 120 L240 44 L240 30 L120 106 L0 30 Z" fill="#c4b5fd" opacity="0.55"/>
    <text x="120" y="115" font-family="Georgia, serif" font-size="90" font-weight="700" text-anchor="middle" dominant-baseline="middle" fill="#7C3AED">T</text>
  </g>

  <!-- Matn (o'ng) -->
  <text x="470" y="290" fill="#ffffff" font-family="Georgia, 'Times New Roman', serif" font-size="76" font-weight="700">Taklifnomachi</text>
  <text x="470" y="360" fill="#ffffff" font-family="Georgia, serif" font-size="44" font-weight="400" opacity="0.85">.online</text>

  <!-- Pastki chiziq -->
  <rect x="472" y="395" width="120" height="4" rx="2" fill="#ffffff" opacity="0.6"/>

  <!-- Tagline -->
  <text x="470" y="450" fill="#f3e8ff" font-family="Arial, sans-serif" font-size="30" font-weight="500">Raqamli taklifnomalar — bitta havolada</text>

  <!-- Kategoriyalar -->
  <text x="470" y="510" fill="#ffffff" font-family="Arial, sans-serif" font-size="26" opacity="0.75">To'y  ·  Tug'ilgan kun  ·  Tadbir  ·  Dil izhori</text>
</svg>
